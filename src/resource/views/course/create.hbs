<div class="container">
  <form action="/courses/store" method="post">
    <div class="group-item">
      <label for="input-form-name">Tên khóa học</label>
      <input type="text" name="name" id="input-form-name" />
    </div>
    <div class="group-item">
      <label for="input-form-description">Mô tả khóa học</label>
      <input type="text" name="description" id="input-form-description" />
    </div>
    <button type="submit">Thêm khóa học</button>
  </form>
</div>